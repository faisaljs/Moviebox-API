# Copy this file to .env in your current directory, or to
# $XDG_CONFIG_HOME/moviebox/.env. Exported shell variables take precedence.

# ─── SERVER ───────────────────────────────────────────────────────────────
PORT=8000
RELOAD=0
REQUEST_TIMEOUT=25
# Bind address. The default keeps direct server runs local; Docker overrides
# this inside the container while publishing the port only on localhost.
MOVIEBOX_BIND_HOST=127.0.0.1
# Optional comma-separated browser origins allowed to call the API cross-origin.
# Same-origin app use works with this empty.
CORS_ORIGINS=

# ─── PLAYER DOMAIN ────────────────────────────────────────────────────────
# Player-domain cache TTL in seconds. Upstream rotates this periodically.
DOMAIN_TTL=300

# ─── CATALOG TABS ─────────────────────────────────────────────────────────
# Tab IDs for /subject/filter. Only used when filter returns real results —
# current upstream returns sentinel for all tabs as a guest, so catalogs
# fall back to /home sections. Kept for when auth situation changes.
TAB_MOVIES=2
TAB_TV=5
TAB_ANIMATION=8

# ─── CATALOG INDEXER ──────────────────────────────────────────────────────
# SQLite path override. The CLI treats `catalog.db` as its per-user default;
# use another path (for example `./catalog.db`) to choose a custom location.
CATALOG_DB=catalog.db

# How often the background walk + enrichment re-runs (seconds).
# 21600 = 6 hours.
CATALOG_REFRESH_INTERVAL=21600

# Max pages per keyword during the walk. If a keyword hits this cap,
# /catalog/stats keyword_stats shows hit_cap: true for it.
# Bump to 200 for deeper coverage on common letters (a, e, m, s, t).
CATALOG_MAX_PAGES_PER_KEYWORD=50

# Enrichment rate limit (seconds between /detail calls).
# 0.2 = 5 requests/sec. Lower = faster but hammer upstream harder.
ENRICH_RATE_LIMIT=0.2

# How many untyped subjects to process per enrichment batch.
ENRICH_BATCH_SIZE=20

# ─── PROVIDERS ────────────────────────────────────────────────────────────
# Primary host. Every BFF request tries this first.
MOVIEBOX_HOST=moviebox.ph

# Known mirror hosts. All share the same aoneroom BFF — dedupe probe
# during walk skips any whose /home hash matches the primary.
MOVIEBOX_HOSTS=moviebox.ph,movie-box.co,movieboxonline.net,movieboxhd.net,123moviesfree.club,sflix.film,netnaija.film

# Background health probe interval (seconds). Each cycle probes one host.
# With 7 hosts, full sweep takes ~7 * interval seconds.
PROVIDER_PROBE_INTERVAL=60

# Timeout for the probe request (seconds). Separate from REQUEST_TIMEOUT
# so a slow upstream doesn't stall the probe loop.
PROVIDER_PROBE_TIMEOUT=8

# Circuit breaker: after N consecutive failures, host is skipped for
# CIRCUIT_BREAKER_SECONDS. 3 fails in a row = open for 60s.
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_SECONDS=60

# Backoff base for 429 retries (seconds).
RETRY_BACKOFF=0.5
